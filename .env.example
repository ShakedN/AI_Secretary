# Which AI runs the conversation: gemini | anthropic
LLM_PROVIDER=gemini

# Gemini — key from https://aistudio.google.com/apikey
# NOTE: on the free tier Google may use what you send to improve its products.
# Use it for testing with made-up details only; real client calls need a paid tier.
GEMINI_API_KEY=
# GEMINI_THINKING_LEVEL=low

# Claude — key from https://console.anthropic.com (only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Optional model overrides (defaults depend on the provider: gemini-3.5-flash-lite / claude-haiku-5-5)
# CHAT_MODEL=
# SUMMARY_MODEL=

# Twilio — the auth token is used to verify webhooks really come from Twilio
TWILIO_AUTH_TOKEN=
# Public https URL Twilio reaches this server on (e.g. ngrok), no trailing slash
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Voice (ConversationRelay). Try a few voices on a real call and keep the best.
LANGUAGE=he-IL
TTS_PROVIDER=Google
TTS_VOICE=he-IL-Wavenet-A
TRANSCRIPTION_PROVIDER=Google
# SPEECH_MODEL=

# Email (Gmail: smtp.gmail.com, port 587, and an App Password — not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# While testing: send every summary here instead of to the lawyers in config.yaml
EMAIL_TO_OVERRIDE=

# Browser voice test at http://localhost:8000/test (no phone needed). Turn off in production.
TEST_PAGE=false
